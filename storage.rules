rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mismos correos que en firestore.rules
    function esEquipo() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'albertogmez99@gmail.com',
             'contactomudanzasdelsur@gmail.com'
           ];
    }

    // Logo y assets públicos (lectura pública, escritura del equipo)
    match /assets/{allPaths=**} {
      allow read:  if true;
      allow write: if esEquipo();
    }

    // PDFs de presupuestos
    match /presupuestos/{userId}/{allPaths=**} {
      allow read, write: if esEquipo();
    }

    // Fotos de trabajos (las del formulario web las sube el servidor en trabajos/web/)
    match /trabajos/{userId}/{allPaths=**} {
      allow read:   if esEquipo();
      allow delete: if esEquipo();
      allow create, update: if esEquipo()
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Inventario
    match /inventario/{userId}/{allPaths=**} {
      allow read:  if esEquipo();
      allow write: if esEquipo()
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
