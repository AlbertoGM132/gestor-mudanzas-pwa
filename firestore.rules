rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el equipo de Mudanzas del Sur (estos correos) puede leer y escribir.
    // Tener una cuenta cualquiera NO basta. Para dar acceso a alguien nuevo,
    // añade su correo aquí, en storage.rules y en EQUIPO de functions/main.py.
    function esEquipo() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'albertogmez99@gmail.com',
             'contactomudanzasdelsur@gmail.com'
           ];
    }

    match /trabajos/{docId}     { allow read, write: if esEquipo(); }
    match /presupuestos/{docId} { allow read, write: if esEquipo(); }
    match /finanzas/{docId}     { allow read, write: if esEquipo(); }
    match /config/{docId}       { allow read, write: if esEquipo(); }
    match /fcm_tokens/{docId} {
      allow read:  if esEquipo();
      allow write: if esEquipo() && request.resource.data.uid == request.auth.uid;
    }
    // Todo lo demás (p. ej. formulario_limites) queda cerrado: solo lo tocan las funciones del servidor.
  }
}
